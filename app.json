{
  "expo": {
    "name": "SubBridge",
    "slug": "subbridge",
    "owner": "drlight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3CE8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.subbridge.app",
      "deploymentTarget": "15.1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.subbridge.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "development",
          "smallIconAccentColor": "#1A3CE8"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SubBridge to use Face ID for authentication."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow SubBridge to access your contacts."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "react-native-quick-crypto"
    ],
    "platforms": [
      "android",
      "ios"
    ],
    "extra": {
      "eas": {
        "projectId": "7ecab4c4-7378-436e-a777-1ccbf4750ea3"
      }
    }
  }
}
